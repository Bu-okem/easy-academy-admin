# Copy to .env.local — that is the file the app reads.
#
# `npx convex dev` creates and maintains .env.local itself, writing
# CONVEX_DEPLOYMENT, CONVEX_URL and CONVEX_SITE_URL. Add the Clerk keys to the
# same file; the package scripts pass `--dotenv .env.local` so Nuxt loads it
# instead of .env.

# Written by `npx convex dev`
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=

# Clerk (https://dashboard.clerk.com)
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NUXT_CLERK_SECRET_KEY=

# Set only while working before Clerk is provisioned: it disables route
# protection in the browser. Pair it with DEV_UNAUTHENTICATED_ROLE on the Convex
# deployment, and remove both once Clerk is configured.
NUXT_PUBLIC_ALLOW_UNAUTHENTICATED=
