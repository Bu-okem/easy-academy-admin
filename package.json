{
  "name": "easy-academy-admin",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "screenshot": "node scripts/screenshot.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm typecheck:domain && pnpm typecheck:convex && pnpm typecheck:app",
    "typecheck:domain": "tsc -p domain/tsconfig.json",
    "typecheck:convex": "tsc -p convex/tsconfig.json",
    "typecheck:app": "nuxt typecheck",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@artmizu/nuxt-prometheus": "3.0.3",
    "@clerk/nuxt": "2.5.2",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/hints": "1.1.2",
    "@nuxt/icon": "2.2.2",
    "@nuxt/image": "2.0.0",
    "@nuxtjs/color-mode": "4.0.0",
    "@nuxtjs/device": "4.0.0",
    "@nuxtjs/google-fonts": "3.2.0",
    "@nuxtjs/seo": "5.1.3",
    "@nuxtjs/svg-sprite": "1.0.2",
    "@nuxtjs/tailwindcss": "6.14.0",
    "convex": "^1.40.0",
    "convex-nuxt": "0.1.5",
    "convex-vue": "^0.1.5",
    "nuxt": "^4.4.6",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
